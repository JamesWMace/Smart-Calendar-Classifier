// Code signing. By default the app is signed to run locally, which needs no Apple account.
// To sign with your own team (so macOS remembers the app's permissions across rebuilds),
// copy Local.xcconfig.example to Local.xcconfig and fill in your team ID. Local.xcconfig
// is git-ignored.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
